# --- Database ---
# Lokal (development): SQLite
DATABASE_URL="file:./dev.db"
# Production (Vercel): ganti ke Postgres, contoh Neon:
# DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# --- Upstash Redis ---
# Ambil dari dashboard Upstash > Database kamu > REST API section
UPSTASH_REDIS_REST_URL="https://xxxx.upstash.io"
UPSTASH_REDIS_REST_TOKEN="xxxxxxxxxxxx"

# --- Cloudinary ---
# Ambil dari dashboard Cloudinary > Settings > Access Keys
CLOUDINARY_CLOUD_NAME="your-cloud-name"
CLOUDINARY_API_KEY="xxxxxxxxxxxx"
CLOUDINARY_API_SECRET="xxxxxxxxxxxx"

# Dipakai di browser (client-side upload) - HARUS diawali NEXT_PUBLIC_
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME="your-cloud-name"
# Buat di Cloudinary > Settings > Upload > Upload presets > Add upload preset
# Signing Mode: Unsigned. Folder default: booth-virtual (opsional).
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET="booth_virtual_unsigned"

# --- Auth vendor (admin dashboard) ---
# String rahasia bebas, buat generate: openssl rand -base64 32
JWT_SECRET="ganti-dengan-string-rahasia-yang-panjang"

# --- App ---
NEXT_PUBLIC_BASE_URL="http://localhost:3000"
